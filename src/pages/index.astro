---
const services = [
  {
    title: 'Transportation',
    text: 'Private cars, premium vans and minibuses with experienced local drivers across Portugal and Spain.',
  },
  {
    title: 'DMC Support',
    text: 'Local coordination for travel agencies, tour operators and travel advisors, from arrival to departure.',
  },
  {
    title: 'Private & Group Travel',
    text: 'Reliable ground operations for FITs, private groups and escorted journeys, tailored to your clients.',
  },
  {
    title: 'Tailor-made Experiences',
    text: 'Flexible itineraries, local guides, dining, activities and experiences designed around your market.',
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Ibervia — Your Travel Partner." />
    <title>Ibervia — Your Travel Partner</title>
  </head>

  <body>
    <header class="nav">
      <a href="/" class="logo">
        <img src="/logo.svg" alt="Ibervia" />
      </a>

      <nav>
        <a href="#services">Services</a>
        <a href="#about">About</a>
        <a href="#destinations">Destinations</a>
        <a href="#contact">Contact</a>
      </nav>

    </header>

    <main>
      <section class="hero">
        <div class="hero-image"></div>

        <div class="hero-content">
          <p class="eyebrow">DESTINATION MANAGEMENT COMPANY</p>

          <h1>
            Your Local Partner<br />
            in Portugal and Spain
          </h1>

          <p class="hero-text">
           Private travel and professional ground services for travel agencies,
           tour operators and travel advisors.
          </p>

          <a href="#contact" class="hero-button">
            Work with us <span>→</span>
          </a>
        </div>

        <div class="hero-bottom">
          <span>DMC · PORTUGAL & SPAIN</span>
          <span>Registered Tourism Operator · RNAAT nº 710/2026</span>
        </div>
      </section>

      <section class="intro" id="about">
        <div class="intro-label">ABOUT <br /> IBERVIA INTERNATIONAL TRAVEL</div>

        <div class="intro-content">
          <h2>
            Local knowledge.<br />
            Professional delivery.
          </h2>
          
          <p>
           Ibervia is a Portugal-based DMC supporting travel agencies, 
           tour operators and travel advisors across Portugal and Spain.
          </p>
          
          <p>
           From private transportation and local guiding to tailor-made itineraries and group operations, 
           we provide reliable on-the-ground support throughout your clients' journey.
          </p>          
        </div>
      </section>

      <section class="services" id="services">
        <div class="section-heading">
          <div>
            <span class="section-label">WHAT WE DO</span>
            <h2>Built around your journey.</h2>
          </div>

          <p>
            One local partner, <br /> from request to departure.
          </p>
        </div>

        <div class="service-grid">
          {services.map((service, index) => (
            <article class="service-card">
              <h3>{service.title}</h3>
              <p>{service.text}</p>
              <a href="#contact">Discover →</a>
            </article>
          ))}
        </div>
      </section>

      <section class="destinations" id="destinations">
        <div class="section-heading">
          <div>
            <span class="section-label">DESTINATIONS</span>
            <h2>Two countries. One local partner.</h2>
          </div>
        </div>

        <div class="destination-grid">
          <a href="#contact" class="destination-card destination-portugal">
            <div class="destination-overlay"></div>

            <div class="destination-content">
              <h3>Portugal</h3>
              <p>
                Lisbon · Porto · Sintra · Douro Valley · Algarve
              </p>
            </div>
          </a>

          <a href="#contact" class="destination-card destination-spain">
            <div class="destination-overlay"></div>

            <div class="destination-content">
              <h3>Spain</h3>
              <p>
                Madrid · Barcelona · Seville · Granada · Malaga
              </p>
            </div>
          </a>
        </div>
      </section>

      <section class="contact" id="contact">
        <span class="section-label"> GET IN TOUCH</span>
        <h2>Let's plan your<br />next journey.</h2>
  
        <!-- 给邮箱加了一个专属 class，防止和下面二维码的链接样式冲突 -->
        <a href="mailto:.com" class="contact-email">info@ibervia.pt →</a>

        <!-- 新增的并排二维码区域 -->
        <div class="contact-social">
          <!-- WhatsApp (带跳转) -->
          <a href="https://wa.me/351926078666" target="_blank" class="contact-social-item">
            <img src="/whatsapp-qr.jpg" alt="WhatsApp QR Code" />
            <span class="contact-social-platform">WhatsApp</span>
            <span class="contact-social-service">English Service</span>
          </a>

          <!-- WeChat (使用 wechat-copy-btn class 来触发复制) -->
          <div class="contact-social-item wechat-copy-btn" data-wechat="DesmondPT">
            <img src="/wechat-qr.jpg" alt="WeChat QR Code" />
            <span class="contact-social-platform">WeChat</span>
            <span class="contact-social-service">中文服务</span>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="footer-logos">
        <img src="/tourism-logos.png" alt="" />
      </div>

      <div class="footer-main">
        <div class="footer-brand">
          <div class="footer-brand-name">IBERVIA</div>
          <p>Your Local Partner in Portugal and Spain</p>
        </div>

        <div class="footer-links">
          <a href="#about">About</a>
          <a href="#services">Services</a>
          <a href="#destinations">Destinations</a>
          <a href="#contact">Contact</a>
        </div>

        <div class="footer-contact">
          <span class="footer-column-title">Contact</span>
          <a href="mailto:info@ibervia.pt" class="footer-email">
            info@ibervia.pt
          </a>
          <div class="footer-social">
            <a href="https://wa.me/351926078666" target="_blank" class="footer-social-item" style="text-decoration: none;">
              <img src="/whatsapp-qr.jpg" alt="WhatsApp QR Code" />
              <span class="social-platform">WhatsApp</span>
              <span class="social-service">English Service</span>
            </a>

            <div class="footer-social-item" id="wechat-copy" data-wechat="DesmondPT" style="cursor: pointer;">
              <img src="/wechat-qr.jpg" alt="WeChat QR Code" />
              <span class="social-platform">WeChat</span>
              <span class="social-service">中文服务</span>
            </div>
          </div>
        </div>
      </div>
      
      <div class="footer-bottom">
        <span>© 2026 Ibervia International Travel</span>
        <span>RNAAT nº 710/2026</span>
        <span>Portugal · Spain</span>
      </div>
    </footer>

    <script>
      // =========================
      // 1. 邮箱一键复制功能
      // =========================
      const emailLinks = document.querySelectorAll('a[href^="mailto:"]');

      emailLinks.forEach(function(link) {
        link.addEventListener('click', function(event) {
          const hrefValue = this.getAttribute('href');
          const emailAddress = hrefValue.replace('mailto:', '');
          
          navigator.clipboard.writeText(emailAddress).then(function() {
            alert('Email address copied to clipboard! \n邮箱地址已复制！');
          }).catch(function(err) {
            console.error('Failed to copy email: ', err);
          });
        });
      });

      // =========================
      // 2. 微信一键复制功能
      // =========================
      const wechatItem = document.getElementById('wechat-copy');
      
      if (wechatItem) {
        wechatItem.addEventListener('click', function() {
          const wechatId = this.getAttribute('data-wechat');
          
          navigator.clipboard.writeText(wechatId).then(function() {
            alert('微信号已复制，请打开微信粘贴添加');
          }).catch(function(err) {
            console.error('Failed to copy WeChat ID: ', err);
            alert('复制失败，请手动记录微信号');
          });
        });
      }
    </script>
  </body>
</html>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Playfair+Display:wght@400;500&display=swap');

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #f3f0e9;
    color: #17252b;
    font-family: 'DM Sans', sans-serif;
  }

  .nav {
    position: absolute;
    z-index: 10;
    top: 0;
    left: 0;
    width: 100%;
    height: 120px;
    padding: 0 5vw;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: white;
  }

  .logo img {
    width: 188px;
    height: auto;
    display: block;
    filter: brightness(0) invert(1);
  }

  nav {
    display: flex;
    gap: 42px;
  }

  nav a,
  .nav-cta {
    color: white;
    text-decoration: none;
    font-size: 18px;
    letter-spacing: .04em;
  }

  .nav-cta {
    border: 1px solid rgba(255,255,255,.65);
    padding: 12px 20px;
  }

  .hero {
    min-height: 100vh;
    position: relative;
    overflow: hidden;
    background: #23343a;
    color: white;
    display: flex;
    align-items: center;
  }

  .hero-image {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(10,20,24,.78), rgba(10,20,24,.28)),
      url('/hero.avif') center / cover;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    width: min(900px, 85vw);
    margin-left: 14vw;
    padding-top: 8vh;
  }

  .eyebrow,
  .section-label,
  .intro-label {
    font-size: 18px;
    line-height: 1.2;
    letter-spacing: .18em;
    font-weight: 600;
  }

  h1,
  h2 {
    font-family: 'Playfair Display', serif;
    font-weight: 400;
  }

  h1 {
    font-size: clamp(58px, 6vw, 88px);
    line-height: 1.05;
    margin: 25px 0 32px;
    letter-spacing: -0.01em;
  }

  .hero-text {
    max-width: 100%;
    font-size: 100%;
    line-height: 1.7;
    color: rgba(255,255,255,.82);
  }

  .hero-button {
    display: inline-flex;
    gap: 25px;
    align-items: center;
    margin-top: 25px;
    padding: 16px 23px;
    background: #f3f0e9;
    color: #17252b;
    text-decoration: none;
    font-size: 13px;
  }

  .hero-bottom {
    position: absolute;
    z-index: 2;
    bottom: 30px;
    left: 5vw;
    right: 5vw;
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    letter-spacing: .15em;
  }

  .intro {
    padding: 150px 10vw;
    display: grid;
    grid-template-columns: 25% 1fr;
    gap: 7vw;
  }

  .intro-content {
    max-width: 750px;
  }

  .intro h2,
  .section-heading h2 {
    font-size: clamp(48px, 5vw, 76px);
    line-height: 1.08;
    margin: 20px 0 45px;
  }

  .intro p {
    max-width: 650px;
    font-size: 18px;
    line-height: 1.8;
    color: #58666a;
  }

  .services {
    padding: 130px 10vw;
    background: #17252b;
    color: white;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 50px;
    margin-bottom: 100px;
  }


  .service-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid rgba(255,255,255,.25);
  }

  .service-card {
    padding: 35px 28px 35px 0;
    border-right: 1px solid rgba(255,255,255,.2);
    margin-right: 28px;
    display: flex;
    flex-direction: column;
  }

  .service-card:last-child {
    border-right: 0;
  }

  .service-card > span {
    font-size: 11px;
    opacity: .5;
  }

  .service-card h3 {
    margin: 45px 0 20px;
    min-height: 76px;
    font-size: 34px;
  }

  .service-card p {
    color: rgba(255,255,255,.72);
    line-height: 1.8;
    font-size: 15px;
    min-height: 100px;
  }

  .service-card a {
    margin-top: auto;
    color: white;
    text-decoration: none;
    font-size: 12px;
  }

  .destinations {
    padding: 120px 10vw;
    background: #f3f0e9;
    color: #17252b;
  }

  .destinations .section-heading {
    margin-bottom: 10px;
  }

  .destination-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
  }

  .destination-card {
    position: relative;
    min-height: 520px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    color: white;
    text-decoration: none;
    background-position: center;
    background-size: cover;
  }

  .destination-portugal {
    background-image: url('/portugal.avif');
  }

  .destination-spain {
    background-image: url('/spain.avif');
  }

  .destination-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(10, 20, 24, .08),
      rgba(10, 20, 24, .78)
    );
    transition: background .4s ease;
  }

  .destination-content {
    position: relative;
    z-index: 2;
    padding: 42px;
  }

  .destination-content span {
    font-size: 11px;
    letter-spacing: .18em;
    opacity: .8;
  }

  .destination-content h3 {
    margin: 12px 0 18px;
    font-family: 'Playfair Display', serif;
    font-size: clamp(48px, 5vw, 76px);
    font-weight: 400;
    line-height: .95;
  }

  .destination-content p {
    margin: 0;
    max-width: 420px;
    font-size: 13px;
    letter-spacing: .04em;
    opacity: .85;
  }

  .destination-card:hover .destination-overlay {
    background: linear-gradient(
      180deg,
      rgba(10, 20, 24, .02),
      rgba(10, 20, 24, .65)
    );
  }

  .destination-card:hover {
    cursor: pointer;
  }

  @media (max-width: 700px) {
    .destination-grid {
      grid-template-columns: 1fr;
    }

    .destination-card {
      min-height: 420px;
    }

    .destination-content {
      padding: 30px;
    }
  }

  .contact {
    padding: 180px 10vw;
    text-align: center;
    background: #17252b;
    color: white;
  }

  .contact h2 {
    font-size: clamp(55px, 7vw, 100px);
    line-height: .95;
    margin: 80px 0 80px; /* 把 35px 改成 80px，间距就拉开了 */
  }

  .contact a {
    color: white;
    text-decoration: none;
    border-bottom: 1px solid rgba(255,255,255,.6);
    padding-bottom: 8px;
    font-size: 24px; /* 👈 新增这行，调整数字可以改变大小 */
    letter-spacing: 0.05em; /* 👈 可选：稍微增加一点字母间距，看起来更高级 */
  }

  /* =========================
     FOOTER
  ========================= */

  footer {
    background: #f3f0e9;
    color: #17252b;
    padding: 0 10vw; /* 👈 把原来的 5vw 改为 10vw，和上面正文对齐 */
  }

  /* =========================
     LOGO STRIP
  ========================= */

    .footer-logos {
    padding: 40px 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid #d7d2c8;
  }

  .footer-logos img {
    display: block;
    width: 100%;
    max-width: 900px; /* 控制最大宽度，防止拉得太宽 */
    height: auto;
    mix-blend-mode: multiply;
  }

  /* =========================
     MAIN FOOTER
  ========================= */

  .footer-main {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 70px;
    max-width: 1100px;
    margin: 0 auto;
    padding: 65px 0 70px;
  }

  /* =========================
     BRAND
  ========================= */

  /* 中间品牌区域整体往右移 */
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 10px;
    /* 👈 核心：在这里加上向右的偏移量。
       数值越大，IBERVIA 整体就越往右走。您可以改成 50px、80px 等来调整 */
    transform: translateX(100px); 
  }

  .footer-brand-name {
    font-family: 'Playfair Display', serif;
    font-size: 38px;
    letter-spacing: .04em;
  }

  .footer-brand p {
    margin: 12px 0 0;
    font-size: 12px;
    letter-spacing: .04em;
    color: #58666a;
  }

  /* =========================
     LINKS
  ========================= */

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer-links a,
  .footer-contact a {
    color: #17252b;
    text-decoration: none;
    font-size: 15px;
    line-height: 1.5;
  }

  .footer-links a:hover,
  .footer-contact a:hover {
    text-decoration: underline;
  }

  /* =========================
     CONTACT
  ========================= */

  .footer-contact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px; 
  }

  .footer-column-title {
    font-size: 15px; 
  }

  .footer-social {
    display: flex;
    gap: 20px; 
    margin-top: 10px; 
  }

  .footer-social-item img {
    width: 82px;
    height: 82px;
    object-fit: contain;
    display: block;
  }

  .footer-social-item {
    display: flex;
    flex-direction: column;
    align-items: center; 
    gap: 4px; 
    text-align: center;
  }

  .social-platform {
    font-weight: 600;
    font-size: 13px;
    color: #17252b;
    line-height: 1; 
  }

  .social-service {
    font-size: 11px;
    color: #58666a;
    letter-spacing: 0.02em;
    line-height: 1; 
  }

  /* =========================
     BOTTOM
  ========================= */

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 0 25px;
    border-top: 1px solid #d7d2c8;
    font-size: 10px;
    letter-spacing: .06em;
    color: #6d777a;
  }

  /* =========================
     TABLET / MOBILE (已优化字号和间距)
  ========================= */

  @media (max-width: 800px) {
    nav {
      display: none;
    }

    .nav-cta {
      display: none;
    }

    .hero-content {
      margin-left: 7vw;
      padding-top: 120px; 
    }

    h1 {
      font-size: clamp(38px, 8vw, 48px); 
      margin: 15px 0 20px; 
    }

    .intro h2,
    .section-heading h2 {
      font-size: clamp(32px, 7vw, 40px);
    }

    .contact h2 {
      font-size: clamp(38px, 8vw, 48px);
    }
    
    .eyebrow,
    .section-label,
    .intro-label {
      font-size: 14px; 
      letter-spacing: .15em;
    }

    .hero-bottom {
      display: none; 
    }

    .intro {
      grid-template-columns: 1fr;
      padding: 100px 7vw;
    }

    .services {
      padding: 100px 7vw;
    }

    .section-heading {
      display: block;
    }

    .service-grid {
      grid-template-columns: 1fr 1fr;
    }

    .service-card:nth-child(2) {
      border-right: 0;
    }

    .contact {
      padding: 120px 7vw;
    }

    .footer-logos {
      padding: 35px 0;
    }

    .footer-logos img {
      width: 100%;
      max-width: 700px;
    }

    .footer-main {
      grid-template-columns: 1fr;
      gap: 35px;
      padding: 50px 0;
    }
    
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
  }

  /* =========================
     SMALL MOBILE
  ========================= */

  @media (max-width: 500px) {
    .service-grid {
      grid-template-columns: 1fr;
    }

    .service-card {
      border-right: 0;
      border-bottom: 1px solid rgba(255,255,255,.2);
      margin: 0;
    }

    .footer-logos {
      padding: 30px 0;
    }

    .footer-logos img {
      width: 100%;
    }

    .footer-brand-name {
      font-size: 32px;
    }
  }
/* =========================
     CONTACT 区域新增二维码样式
  ========================= */
  
  /* 修复邮箱下划线样式，覆盖原来的 .contact a */
  .contact a.contact-email {
    color: white;
    text-decoration: none;
    border-bottom: 1px solid rgba(255,255,255,.6);
    padding-bottom: 8px;
    display: inline-block;
  }

  /* 二维码外层容器 */
  .contact-social {
    display: flex;
    justify-content: center;
    gap: 80px; /* 两个二维码之间留出非常宽敞的距离 */
    margin-top: 70px; /* 与上方的邮箱拉开距离 */
  }

  /* 消除 a 标签自带的下划线（覆盖原代码） */
  .contact a.contact-social-item {
    border-bottom: none;
    padding-bottom: 0;
  }

  .contact-social-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    text-decoration: none;
  }

  /* 控制 Contact 里的二维码变大 */
  .contact-social-item img {
    width: 140px; /* 比底部的 82px 大很多 */
    height: 140px;
    object-fit: contain;
    border-radius: 8px; /* 加一点微小的圆角看起来更精致 */
  }

  .contact-social-platform {
    font-weight: 600;
    font-size: 15px;
    color: white; /* 在深色背景上必须用白色文字 */
    line-height: 1;
    margin-top: 8px;
  }

  .contact-social-service {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.7); /* 次要文字使用带透明度的白色 */
    letter-spacing: 0.02em;
    line-height: 1;
  }

  /* 移动端适配：稍微缩小一点，防止手机屏幕塞不下 */
  @media (max-width: 800px) {
    .contact-social {
      gap: 35px; /* 手机端两个二维码靠近一点 */
      margin-top: 50px;
    }
    
    .contact-social-item img {
      width: 115px; /* 手机端稍微缩小 */
      height: 115px;
    }
  }
</style>