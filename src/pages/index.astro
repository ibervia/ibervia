---
const services = [
  {
    title: 'Transportation',
    text: 'Private cars, premium vans and minibuses with experienced local drivers across Portugal and Spain.',
  },
  {
    title: 'DMC Support',
    text: 'Local coordination for travel agencies, tour operators and travel advisors, from arrival to departure.',
  },
  {
    title: 'Private & Group Travel',
    text: 'Reliable ground operations for FITs, private groups and escorted journeys, tailored to your clients.',
  },
  {
    title: 'Tailor-made Experiences',
    text: 'Flexible itineraries, local guides, dining, activities and experiences designed around your market.',
  },
];

---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Ibervia — Your Travel Partner." />
    <title>Ibervia — Your Travel Partner</title>
  </head>

  <body>
    <header class="nav">
      <a href="/" class="logo">
        <img src="/logo.svg" alt="Ibervia" />
      </a>

      <nav>
        <a href="#services">Services</a>
        <a href="#about">About</a>
        <a href="#destinations">Destinations</a>
        <a href="#contact">Contact</a>
      </nav>

    </header>

    <main>
<section class="hero">
  <div class="hero-image"></div>

  <div class="hero-content">
    <p class="eyebrow">DESTINATION MANAGEMENT COMPANY</p>

    <h1>
      Your Local Partner<br />
      in Portugal and Spain
    </h1>

    <p class="hero-text">
     Private travel and professional ground services for travel agencies,
     tour operators and travel advisors.
    </p>

    <a href="#contact" class="hero-button">
      Work with us <span>→</span>
    </a>
  </div>

  <div class="hero-bottom">
    <span>DMC · PORTUGAL & SPAIN</span>
    <span>Registered Tourism Operator · RNAAT nº 710/2026</span>
  </div>

</section>

      <section class="intro" id="about">
        <div class="intro-label">ABOUT <br /> IBERVIA INTERNATIONAL TRAVEL</div>

        <div class="intro-content">
          <h2>
            Local knowledge.<br />
            Professional delivery.
          </h2>
          
          <p>
           Ibervia is a Portugal-based DMC supporting travel agencies, 
           tour operators and travel advisors across Portugal and Spain.
          </p>
          
          <p>
           From private transportation and local guiding to tailor-made itineraries and group operations, 
           we provide reliable on-the-ground support throughout your clients' journey.
          </p>          
        </div>
      </section>

      <section class="services" id="services">
        <div class="section-heading">
          <div>
            <span class="section-label">WHAT WE DO</span>
            <h2>Built around your journey.</h2>
          </div>

          <p>
            One local partner, <br /> from request to departure.
          </p>
        </div>

        <div class="service-grid">
          {services.map((service, index) => (
            <article class="service-card">
              <h3>{service.title}</h3>
              <p>{service.text}</p>
              <a href="#contact">Discover →</a>
            </article>
          ))}
        </div>
      </section>

<section class="destinations" id="destinations">
  <div class="section-heading">
    <div>
      <span class="section-label">DESTINATIONS</span>
      <h2>Two countries.  One local partner.</h2>
    </div>
      
    <p>
      Local expertise and seamless ground support across Portugal and Spain.
    </p>
  </div>

  <div class="destination-grid">
    <a href="#contact" class="destination-card destination-portugal">
      <div class="destination-overlay"></div>

      <div class="destination-content">
        <h3>Portugal</h3>
        <p>
          Lisbon · Porto · Sintra · Douro Valley · Algarve
        </p>
      </div>
    </a>

    <a href="#contact" class="destination-card destination-spain">
      <div class="destination-overlay"></div>

      <div class="destination-content">
        <h3>Spain</h3>
        <p>
          Madrid · Barcelona · Seville · Granada · Malaga
        </p>
      </div>
    </a>
  </div>
</section>

<section class="contact" id="contact">
  <span class="section-label"> GET IN TOUCH</span>
  <h2>Let's plan your<br />next journey.</h2>
  <a href="mailto:Ibervia.pt@gmail.com">Ibervia.pt@gmail.com →</a>
</section>

</main>

<footer>
  <div class="footer-logos">
    <img src="/tourism-logos.png" alt="" />
  </div>

  <div class="footer-main">
    <div class="footer-brand">
      <div class="footer-brand-name">IBERVIA</div>
      <p>Your Local Partner in Portugal and Spain</p>
    </div>

    <div class="footer-links">
      <a href="#about">About</a>
      <a href="#services">Services</a>
      <a href="#destinations">Destinations</a>
      <a href="#contact">Contact</a>
    </div>

    <div class="footer-contact">
      <span class="footer-column-title">Contact</span>
      <a href="mailto:Ibervia.pt@gmail.com" class="footer-email">
        Ibervia.pt@gmail.com
      </a>
      <div class="footer-social">
        <div class="footer-social-item">
          <img src="/whatsapp-qr.jpg" alt="WhatsApp QR Code" />
          <span class="social-platform">WhatsApp</span>
          <span class="social-service">English Service</span>
        </div>
        <div class="footer-social-item">
          <img src="/wechat-qr.jpg" alt="WeChat QR Code" />
          <span class="social-platform">WeChat</span>
          <span class="social-service">中文服务</span>
        </div>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© 2026 Ibervia International Travel</span>
    <span>RNAAT nº 710/2026</span>
    <span>Portugal · Spain</span>
  </div>
</footer>

<script>
  // 获取邮箱链接元素
  const emailLink = document.querySelector('.footer-email');

  if (emailLink) {
    emailLink.addEventListener('click', function(event) {
      // 获取邮箱地址
      const emailAddress = 'Ibervia.pt@gmail.com';
      
      // 使用现代 Clipboard API 复制文本
      navigator.clipboard.writeText(emailAddress).then(function() {
        // 复制成功后的提示（您可以换成更美观的 UI 提示，这里用最简单的 alert 演示）
        alert('Email address copied to clipboard! \n邮箱地址已复制！');
      }).catch(function(err) {
        console.error('Failed to copy email: ', err);
      });
    });
  }
</script>

</body>

</html>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Playfair+Display:wght@400;500&display=swap');

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #f3f0e9;
    color: #17252b;
    font-family: 'DM Sans', sans-serif;
  }

  .nav {
    position: absolute;
    z-index: 10;
    top: 0;
    left: 0;
    width: 100%;
    height: 120px;
    padding: 0 5vw;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: white;
  }

  .logo img {
  width: 188px;
  height: auto;
  display: block;
  filter: brightness(0) invert(1);
  }

  nav {
    display: flex;
    gap: 42px;
  }

  nav a,
  .nav-cta {
    color: white;
    text-decoration: none;
    font-size: 18px;
    letter-spacing: .04em;
  }

  .nav-cta {
    border: 1px solid rgba(255,255,255,.65);
    padding: 12px 20px;
  }

  .hero {
    min-height: 100vh;
    position: relative;
    overflow: hidden;
    background: #23343a;
    color: white;
    display: flex;
    align-items: center;
  }

  .hero-image {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(10,20,24,.78), rgba(10,20,24,.28)),
      url('/hero.avif') center / cover;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    width: min(900px, 85vw);
    margin-left: 14vw;
    padding-top: 8vh;
  }

  .eyebrow,
  .section-label,
  .intro-label {
    font-size: 18px;
    line-height: 1.2;
    letter-spacing: .18em;
    font-weight: 600;
  }

  h1,
  h2 {
    font-family: 'Playfair Display', serif;
    font-weight: 400;
  }

  h1 {
    font-size: clamp(58px, 6vw, 88px);
    line-height: 1.05;
    margin: 25px 0 32px;
    letter-spacing: -0.01em;
  }

  .hero-text {
    max-width: 100%;
    font-size: 100%;
    line-height: 1.7;
    color: rgba(255,255,255,.82);
  }

  .hero-button {
    display: inline-flex;
    gap: 25px;
    align-items: center;
    margin-top: 25px;
    padding: 16px 23px;
    background: #f3f0e9;
    color: #17252b;
    text-decoration: none;
    font-size: 13px;
  }

  .hero-bottom {
    position: absolute;
    z-index: 2;
    bottom: 30px;
    left: 5vw;
    right: 5vw;
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    letter-spacing: .15em;
  }

  .intro {
    padding: 150px 10vw;
    display: grid;
    grid-template-columns: 25% 1fr;
    gap: 7vw;
  }

  .intro-content {
    max-width: 750px;
  }

  .intro h2,
  .section-heading h2 {
    font-size: clamp(48px, 5vw, 76px);
    line-height: 1.08;
    margin: 20px 0 45px;
  }

  .intro p {
    max-width: 650px;
    font-size: 18px;
    line-height: 1.8;
    color: #58666a;
  }

  .services {
    padding: 130px 10vw;
    background: #17252b;
    color: white;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 50px;
    margin-bottom: 100px;
  }

  .section-heading > p {
    max-width: 300px;
    line-height: 1.7;
    color: rgba(255,255,255,.6);
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid rgba(255,255,255,.25);
  }

 .service-card {
  padding: 35px 28px 35px 0;
  border-right: 1px solid rgba(255,255,255,.2);
  margin-right: 28px;
  display: flex;
  flex-direction: column;
  }

.service-card:last-child {
  border-right: 0;
}

.service-card > span {
  font-size: 11px;
  opacity: .5;
}

.service-card h3 {
  margin: 45px 0 20px;
  min-height: 76px;
  font-size: 34px;
}

.service-card p {
  color: rgba(255,255,255,.72);
  line-height: 1.8;
  font-size: 15px;
  min-height: 100px;
}

.service-card a {
  margin-top: auto;
  color: white;
  text-decoration: none;
  font-size: 12px;
}

.destinations {
  padding: 120px 10vw;
  background: #f3f0e9;
  color: #17252b;
}

.destinations .section-heading {
  margin-bottom: 100px;
}

.destination-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2px;
}

.destination-card {
  position: relative;
  min-height: 520px;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
  color: white;
  text-decoration: none;
  background-position: center;
  background-size: cover;
}

.destination-portugal {
  background-image: url('/portugal.avif');
}

.destination-spain {
  background-image: url('/spain.avif');
}

.destination-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    rgba(10, 20, 24, .08),
    rgba(10, 20, 24, .78)
  );
  transition: background .4s ease;
}

.destination-content {
  position: relative;
  z-index: 2;
  padding: 42px;
}

.destination-content span {
  font-size: 11px;
  letter-spacing: .18em;
  opacity: .8;
}

.destination-content h3 {
  margin: 12px 0 18px;
  font-family: 'Playfair Display', serif;
  font-size: clamp(48px, 5vw, 76px);
  font-weight: 400;
  line-height: .95;
}

.destination-content p {
  margin: 0;
  max-width: 420px;
  font-size: 13px;
  letter-spacing: .04em;
  opacity: .85;
}

.destination-card:hover .destination-overlay {
  background: linear-gradient(
    180deg,
    rgba(10, 20, 24, .02),
    rgba(10, 20, 24, .65)
  );
}

.destination-card:hover {
  cursor: pointer;
}

@media (max-width: 700px) {
  .destination-grid {
    grid-template-columns: 1fr;
  }

  .destination-card {
    min-height: 420px;
  }

  .destination-content {
    padding: 30px;
  }
}

  .contact {
    padding: 180px 10vw;
    text-align: center;
    background: #17252b;
    color: white;
  }

  .contact h2 {
    font-size: clamp(55px, 7vw, 100px);
    line-height: .95;
    margin: 35px 0 45px;
  }

  .contact a {
    color: white;
    text-decoration: none;
    border-bottom: 1px solid rgba(255,255,255,.6);
    padding-bottom: 8px;
  }


  @media (max-width: 800px) {
    nav {
      display: none;
    }

    .nav-cta {
      display: none;
    }

    .hero-content {
      margin-left: 7vw;
    }

    .hero-bottom span:last-child {
      display: none;
    }

    .intro {
      grid-template-columns: 1fr;
      padding: 100px 7vw;
    }

    .services {
      padding: 100px 7vw;
    }

    .section-heading {
      display: block;
    }

    .service-grid {
      grid-template-columns: 1fr 1fr;
    }

    .service-card:nth-child(2) {
      border-right: 0;
    }

    .contact {
      padding: 120px 7vw;
    }


  }

  @media (max-width: 500px) {
    .service-grid {
      grid-template-columns: 1fr;
    }

    .service-card {
      border-right: 0;
      border-bottom: 1px solid rgba(255,255,255,.2);
      margin: 0;
    }
  }

/* =========================
   FOOTER
========================= */

footer {
  background: #f3f0e9;
  color: #17252b;
  padding: 0 5vw;
}


/* =========================
   LOGO STRIP
========================= */

.footer-logos {
  padding: 30px 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 1px solid #d7d2c8;
}

.footer-logos img {
  display: block;
  width: min(900px, 100%);
  height: auto;
  mix-blend-mode: multiply;
}


/* =========================
   MAIN FOOTER
========================= */

.footer-main {
  display: grid;
  grid-template-columns: 1.5fr 1fr 1fr;
  gap: 70px;
  max-width: 1100px;
  margin: 0 auto;
  padding: 65px 0 70px;
}


/* =========================
   BRAND
========================= */

.footer-brand-name {
  font-family: 'Playfair Display', serif;
  font-size: 38px;
  letter-spacing: .04em;
}

.footer-brand p {
  margin: 12px 0 0;
  font-size: 12px;
  letter-spacing: .04em;
  color: #58666a;
}


/* =========================
   LINKS
========================= */

.footer-links {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.footer-links a,
.footer-contact a {
  color: #17252b;
  text-decoration: none;
  font-size: 15px;
  line-height: 1.5;
}

.footer-links a:hover,
.footer-contact a:hover {
  text-decoration: underline;
}


/* =========================
   CONTACT
========================= */

.footer-contact {
  display: flex;
  flex-direction: column; /* 👈 关键修复：将横向排列改为纵向排列 */
  align-items: flex-start; /* 让内容在这一列里靠左对齐 */
  gap: 16px; /* 让标题、邮箱、二维码之间产生均匀的垂直间距 */
}

/* 统一标题的字体大小 */
.footer-column-title {
  font-size: 15px; 
}

/* 二维码容器排版 */
.footer-social {
  display: flex;
  gap: 20px; /* 让 WhatsApp 和 WeChat 左右并排，不再上下拥挤 */
  margin-top: 10px; /* 与上方的邮箱地址拉开一点呼吸空间 */
}

/* 单个二维码和文字的组合 */
.footer-social-item {
  display: flex;
  flex-direction: column;
  align-items: center; /* 文字在二维码下方居中 */
  gap: 8px; /* 二维码和文字之间的微小间距 */
  font-size: 12px; /* 缩小二维码下方说明文字的大小 */
  color: #58666a;
}

.footer-social-item img {
  width: 82px;
  height: 82px;
  object-fit: contain;
  display: block;
}

/* 单个二维码和文字的组合 */
.footer-social-item {
  display: flex;
  flex-direction: column;
  align-items: center; /* 文字在二维码下方居中 */
  gap: 4px; /* 缩小间距，让文本看起来更紧凑 */
  text-align: center;
}

/* 软件名称样式 */
.social-platform {
  font-weight: 600;
  font-size: 13px;
  color: #17252b;
  line-height: 1; /* 👈 新增：强制行高为 1，去除顶部和底部的默认多余空白 */
}

/* 语言服务说明样式 */
.social-service {
  font-size: 11px;
  color: #58666a;
  letter-spacing: 0.02em;
  line-height: 1; /* 👈 新增：强制行高为 1 */
}

/* =========================
   BOTTOM
========================= */

.footer-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;

  padding: 20px 0 25px;

  border-top: 1px solid #d7d2c8;

  font-size: 10px;
  letter-spacing: .06em;
  color: #6d777a;
}


/* =========================
   TABLET / MOBILE
========================= */

@media (max-width: 800px) {

  .footer-logos {
    padding: 35px 0;
  }

  .footer-logos img {
    width: 100%;
    max-width: 700px;
  }

  .footer-main {
    grid-template-columns: 1fr;
    gap: 35px;
    padding: 50px 0;
  }
  
  .footer-bottom {
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

}


/* =========================
   SMALL MOBILE
========================= */

@media (max-width: 500px) {

  .footer-logos {
    padding: 30px 0;
  }

  .footer-logos img {
    width: 100%;
  }

  .footer-brand-name {
    font-size: 32px;
  }
}
</style>