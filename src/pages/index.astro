---
const services = [
  {
    title: 'Transportation',
    text: 'Private cars, premium vans and minibuses with experienced local drivers across Portugal and Spain.',
  },
  {
    title: 'DMC Support',
    text: 'Local coordination for travel agencies, tour operators and travel advisors, from arrival to departure.',
  },
  {
    title: 'Private & Group Travel',
    text: 'Reliable ground operations for FITs, private groups and escorted journeys, tailored to your clients.',
  },
  {
    title: 'Tailor-made Experiences',
    text: 'Flexible itineraries, local guides, dining, activities and experiences designed around your market.',
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Ibervia — Your Travel Partner." />
    <title>Ibervia — Your Travel Partner</title>
  </head>

  <body>
    <header class="nav">
      <a href="/" class="logo">
        <img src="/logo.svg" alt="Ibervia" />
      </a>

      <nav>
        <a href="#services">Services</a>
        <a href="#fleet">Fleet</a>
        <a href="#about">About</a>
        <a href="#destinations">Destinations</a>
        <a href="#contact">Contact</a>
      </nav>

    </header>

    <main>
      <section class="hero">
        <div class="hero-image"></div>

        <div class="hero-content">
          <p class="eyebrow">DESTINATION MANAGEMENT COMPANY</p>

          <h1>
            Your Local Partner<br />
            in Portugal and Spain
          </h1>

          <p class="hero-text">
           Private travel and professional ground services for travel agencies,
           tour operators and travel advisors.
          </p>

          <a href="#contact" class="hero-button">
            Work with us <span>→</span>
          </a>
        </div>

        <div class="hero-bottom">
          <span>DMC · PORTUGAL & SPAIN</span>
          <span>Registered Tourism Operator · RNAAT nº 710/2026</span>
        </div>
      </section>

      <section class="intro" id="about">
        <div class="intro-label">ABOUT <br /> IBERVIA INTERNATIONAL TRAVEL</div>

        <div class="intro-content">
          <h2>
            Local knowledge.<br />
            Professional delivery.
          </h2>
          
          <p>
           Ibervia is a Portugal-based DMC supporting travel agencies, 
           tour operators and travel advisors across Portugal and Spain.
          </p>
          
          <p>
           From private transportation and local guiding to tailor-made itineraries and group operations, 
           we provide reliable on-the-ground support throughout your clients' journey.
          </p>          
        </div>
      </section>

      <section class="services" id="services">
        <div class="section-heading">
          <div>
            <span class="section-label">WHAT WE DO</span>
            <h2>Built around your journey.</h2>
          </div>

          <p>
            One local partner, <br /> from request to departure.
          </p>
        </div>

        <div class="service-grid">
          {services.map((service, index) => (
            <article class="service-card">
              <h3>{service.title}</h3>
              <p>{service.text}</p>
              <a href="#contact">Discover →</a>
            </article>
          ))}
        </div>
      </section>


      <!-- ==========================================
         新增：OUR FLEET 车队展示板块 (对应宣传册第 04 页)
      ========================================== -->
      <section class="fleet" id="fleet">
        <div class="section-heading">
          <div>
            <span class="section-label">OUR FLEET</span>
            <h2>Our Fleet. Your Journey.</h2>
          </div>
          <p>
            Professional fleet, licensed drivers, <br /> and seamless coordination.
          </p>
        </div>

        <!-- 顶部全景车队合影大图 -->
        <div class="fleet-banner">
          <img src="/fleet-group.jpg" alt="Ibervia Fleet Lineup" />
        </div>

        <!-- 车型分类卡片网格 -->
        <div class="fleet-grid">
          <!-- 卡片 1: 行政轿车 -->
          <div class="fleet-card">
            <div class="fleet-card-img">
              <img src="/fleet-executive.jpg" alt="Executive Vehicles" />
            </div>
            <div class="fleet-card-info">
              <h3>Executive Vehicles</h3>
              <p class="fleet-subtitle">Private Transfers · VIP Travel · Executive Transportation</p>
            </div>
          </div>

          <!-- 卡片 2: 商务小巴 -->
          <div class="fleet-card">
            <div class="fleet-card-img">
              <img src="/fleet-minibus.jpg" alt="Minibuses" />
            </div>
            <div class="fleet-card-info">
              <h3>Minibuses</h3>
              <p class="fleet-subtitle">Group Transfers · Corporate Travel</p>
            </div>
          </div>

          <!-- 卡片 3: 大型团队用车 -->
          <div class="fleet-card">
            <div class="fleet-card-img">
              <img src="/fleet-coach.jpg" alt="Group Vehicles" />
            </div>
            <div class="fleet-card-info">
              <h3>Group Vehicles</h3>
              <p class="fleet-subtitle">Large Groups · Tour Operators · MICE</p>
              <p class="fleet-subtitle2">Available upon request</p>
            </div>
          </div>
        </div>
      </section>

      <section class="destinations" id="destinations">
        <div class="section-heading">
          <div>
            <span class="section-label">DESTINATIONS</span>
            <h2>Two countries. One local partner.</h2>
          </div>
        </div>

        <div class="destination-grid">
          <a href="#contact" class="destination-card destination-portugal">
            <div class="destination-overlay"></div>

            <div class="destination-content">
              <h3>Portugal</h3>
              <p>
                Lisbon · Porto · Sintra · Douro Valley · Algarve
              </p>
            </div>
          </a>

          <a href="#contact" class="destination-card destination-spain">
            <div class="destination-overlay"></div>

            <div class="destination-content">
              <h3>Spain</h3>
              <p>
                Madrid · Barcelona · Seville · Granada · Malaga
              </p>
            </div>
          </a>
        </div>
      </section>

      <section class="contact" id="contact">
        <span class="section-label"> GET IN TOUCH</span>
        <h2>Let's plan your<br />next journey.</h2>
  
        <a href="mailto:info@ibervia.pt" class="contact-email">info@ibervia.pt →</a>

        <div class="contact-social">
          <a href="https://wa.me/351926078666" target="_blank" class="contact-social-item">
            <img src="/whatsapp-qr.jpg" alt="WhatsApp QR Code" />
            <span class="contact-social-platform">WhatsApp</span>
            <span class="contact-social-service">English Service</span>
          </a>

          <div class="contact-social-item wechat-copy-btn" data-wechat="DesmondPT">
            <img src="/wechat-qr.jpg" alt="WeChat QR Code" />
            <span class="contact-social-platform">WeChat</span>
            <span class="contact-social-service">中文服务</span>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="footer-logos">
        <img src="/tourism-logos.png" alt="" />
      </div>

      <div class="footer-main">
        <div class="footer-brand">
          <img src="/logo.svg" alt="IBERVIA Logo" class="footer-brand-logo">
          <p>Your Local Partner <br />in Portugal and Spain</p>
        </div>

        <div class="footer-links">
          <a href="#about">About</a>
          <a href="#services">Services</a>
          <a href="#fleet">Fleet</a>
          <a href="#destinations">Destinations</a>
          <a href="#contact">Contact</a>
        </div>

        <div class="footer-contact">
          <span class="footer-column-title">Contact</span>
          <a href="mailto:info@ibervia.pt" class="footer-email">
            info@ibervia.pt
          </a>
          <div class="footer-social">
            <a href="https://wa.me/351926078666" target="_blank" class="footer-social-item" style="text-decoration: none;">
              <img src="/whatsapp-qr.jpg" alt="WhatsApp QR Code" />
              <span class="social-platform">WhatsApp</span>
              <span class="social-service">English Service</span>
            </a>

            <div class="footer-social-item" id="wechat-copy" data-wechat="DesmondPT" style="cursor: pointer;">
              <img src="/wechat-qr.jpg" alt="WeChat QR Code" />
              <span class="social-platform">WeChat</span>
              <span class="social-service">中文服务</span>
            </div>
          </div>
        </div>
      </div>
      
      <div class="footer-bottom">
        <span>© 2026 Ibervia International Travel</span>
        <span>RNAAT nº 710/2026</span>
        <span>Portugal · Spain</span>
      </div>
    </footer>

    <script>
      const emailLinks = document.querySelectorAll('a[href^="mailto:"]');

      emailLinks.forEach(function(link) {
        link.addEventListener('click', function(event) {
          const hrefValue = this.getAttribute('href');
          const emailAddress = hrefValue.replace('mailto:', '');
          
          navigator.clipboard.writeText(emailAddress).then(function() {
            alert('Email address copied to clipboard! \n邮箱地址已复制！');
          }).catch(function(err) {
            console.error('Failed to copy email: ', err);
          });
        });
      });

      const wechatItem = document.getElementById('wechat-copy');
      
      if (wechatItem) {
        wechatItem.addEventListener('click', function() {
          const wechatId = this.getAttribute('data-wechat');
          
          navigator.clipboard.writeText(wechatId).then(function() {
            alert('微信号已复制，请打开微信粘贴添加');
          }).catch(function(err) {
            console.error('Failed to copy WeChat ID: ', err);
            alert('复制失败，请手动记录微信号');
          });
        });
      }
    </script>
  </body>
</html>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Playfair+Display:wght@400;500&display=swap');

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #f3f0e9;
    color: #17252b;
    font-family: 'DM Sans', sans-serif;
  }

  .nav {
    position: absolute;
    z-index: 10;
    top: 0;
    left: 0;
    width: 100%;
    height: 120px;
    padding: 0 5vw;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: white;
  }

  .logo img {
    width: 188px;
    height: auto;
    display: block;
    filter: brightness(0) invert(1);
  }

  nav {
    display: flex;
    gap: 42px;
  }

  nav a,
  .nav-cta {
    color: white;
    text-decoration: none;
    font-size: 18px;
    letter-spacing: .04em;
  }

  .hero {
    min-height: 100vh;
    position: relative;
    overflow: hidden;
    background: #23343a;
    color: white;
    display: flex;
    align-items: center;
  }

  .hero-image {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(10,20,24,.78), rgba(10,20,24,.28)),
      url('/hero.avif') center / cover;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    width: min(900px, 85vw);
    margin-left: 14vw;
    padding-top: 8vh;
  }

  .eyebrow,
  .section-label,
  .intro-label {
    font-size: 18px;
    line-height: 1.2;
    letter-spacing: .18em;
    font-weight: 600;
  }

  h1,
  h2 {
    font-family: 'Playfair Display', serif;
    font-weight: 400;
  }

  h1 {
    font-size: clamp(58px, 6vw, 88px);
    line-height: 1.05;
    margin: 25px 0 32px;
    letter-spacing: -0.01em;
  }

  .hero-text {
    max-width: 100%;
    font-size: 100%;
    line-height: 1.7;
    color: rgba(255,255,255,.82);
  }

  .hero-button {
    display: inline-flex;
    gap: 25px;
    align-items: center;
    margin-top: 25px;
    padding: 16px 23px;
    background: #f3f0e9;
    color: #17252b;
    text-decoration: none;
    font-size: 13px;
  }

  .hero-bottom {
    position: absolute;
    z-index: 2;
    bottom: 30px;
    left: 5vw;
    right: 5vw;
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    letter-spacing: .15em;
  }

  .intro {
    padding: 150px 10vw;
    display: grid;
    grid-template-columns: 25% 1fr;
    gap: 7vw;
  }

  .intro-content {
    max-width: 750px;
  }

  .intro h2,
  .section-heading h2 {
    font-size: clamp(48px, 5vw, 76px);
    line-height: 1.08;
    margin: 20px 0 45px;
  }

  .intro p {
    max-width: 650px;
    font-size: 18px;
    line-height: 1.8;
    color: #58666a;
  }

  .services {
    padding: 130px 10vw;
    background: #17252b;
    color: white;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 50px;
    margin-bottom: 100px;
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid rgba(255,255,255,.25);
  }

  .service-card {
    padding: 35px 28px 35px 0;
    border-right: 1px solid rgba(255,255,255,.2);
    margin-right: 28px;
    display: flex;
    flex-direction: column;
  }

  .service-card:last-child {
    border-right: 0;
  }

  .service-card h3 {
    margin: 45px 0 20px;
    min-height: 76px;
    font-size: 34px;
  }

  .service-card p {
    color: rgba(255,255,255,.72);
    line-height: 1.8;
    font-size: 15px;
    min-height: 100px;
  }

  .service-card a {
    margin-top: auto;
    color: white;
    text-decoration: none;
    font-size: 12px;
  }

 /* ==========================================
     FLEET 车队展示板块样式 (浅色反转版)
  ========================================== */
  .fleet {
    padding: 130px 10vw;
    background: #f3f0e9;
    color: #17252b;
    border-top: 1px solid rgba(23, 37, 43, 0.1);
  }

  .fleet .section-heading h2 {
    color: #17252b;
  }

  .fleet-banner {
    margin-bottom: 40px;
    width: 100%;
    overflow: hidden;
    border-radius: 4px;
  }

  .fleet-banner img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    max-height: 500px;
  }

  .fleet-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }

  .fleet-card {
    background: #ffffff;
    border: 1px solid rgba(23, 37, 43, 0.1);
    border-radius: 4px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .fleet-card:hover {
    transform: translateY(-5px);
    border-color: rgba(23, 37, 43, 0.3);
    box-shadow: 0 10px 30px rgba(23, 37, 43, 0.05);
  }

  .fleet-card-img img {
    width: 100%;
    height: 240px;
    object-fit: cover;
    display: block;
  }

  .fleet-card-info {
    padding: 25px;
  }

  .fleet-card-info h3 {
    font-family: 'Playfair Display', serif;
    font-size: 26px;
    margin: 0 0 12px 0;
    color: #17252b;
  }

  .fleet-subtitle {
    font-size: 13px;
    line-height: 1.6;
    color: #58666a;
    margin: 0;
    letter-spacing: 0.02em;
  }
  .fleet-subtitle2 {
    font-size: 13px;
    line-height: 1.6;
    color: #58666a;
    margin: 0;
    letter-spacing: 0.02em;
    font-style: italic;
  }
 /* ==========================================
     DESTINATIONS (深色反转版)
  ========================================== */
  .destinations {
    padding: 120px 10vw;
    background: #17252b;
    color: white;
  }

  .destinations .section-heading {
    margin-bottom: 10px;
  }

  .destinations .section-heading h2 {
    color: white;
  }

  .destination-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
  }

  .destination-card {
    position: relative;
    min-height: 520px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    color: white;
    text-decoration: none;
    background-position: center;
    background-size: cover;
  }

  .destination-portugal {
    background-image: url('/portugal.avif');
  }

  .destination-spain {
    background-image: url('/spain.avif');
  }

  .destination-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(10, 20, 24, .08),
      rgba(10, 20, 24, .78)
    );
    transition: background .4s ease;
  }

  .destination-content {
    position: relative;
    z-index: 2;
    padding: 42px;
  }

  .destination-content h3 {
    margin: 12px 0 18px;
    font-family: 'Playfair Display', serif;
    font-size: clamp(48px, 5vw, 76px);
    font-weight: 400;
    line-height: .95;
    color: white;
  }

  .destination-content p {
    margin: 0;
    max-width: 420px;
    font-size: 13px;
    letter-spacing: .04em;
    opacity: .85;
  }

/* ==========================================
     CONTACT (强制浅色反转版)
  ========================================== */
  .contact {
    padding: 180px 10vw !important;
    text-align: center !important;
    background: #f3f0e9 !important;
    color: #17252b !important;
  }

  .contact h2 {
    font-size: clamp(55px, 7vw, 100px) !important;
    line-height: .95 !important;
    margin: 80px 0 !important;
    color: #17252b !important;
  }

  .contact a.contact-email {
    color: #17252b !important;
    text-decoration: none !important;
    border-bottom: 1px solid rgba(23, 37, 43, 0.6) !important;
    padding-bottom: 8px !important;
    font-size: 24px !important;
    letter-spacing: 0.05em !important;
    display: inline-block !important;
  }

  .contact-social {
    display: flex !important;
    justify-content: center !important;
    gap: 80px !important;
    margin-top: 70px !important;
  }

  .contact a.contact-social-item {
    border-bottom: none !important;
    padding-bottom: 0 !important;
  }

  .contact-social-item {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    gap: 8px !important;
    cursor: pointer !important;
    text-decoration: none !important;
  }

  .contact-social-item img {
    width: 140px !important;
    height: 140px !important;
    object-fit: contain !important;
    border-radius: 8px !important;
  }

  .contact-social-platform {
    font-weight: 600 !important;
    font-size: 15px !important;
    color: #17252b !important;
    line-height: 1 !important;
    margin-top: 8px !important;
  }

  .contact-social-service {
    font-size: 13px !important;
    color: #58666a !important;
    letter-spacing: 0.02em !important;
    line-height: 1 !important;
  }

/* ==========================================
     FOOTER (Logo区保持浅色，其余主体反转为深色)
  ========================================== */
  
  /* 1. 整个 footer 的默认底层设为深色 */
  footer {
    background: #17252b !important;
    color: white !important;
    padding: 0 10vw;
  }

  /* 2. 独立将 Logo 区（第一栏）强制改为浅色背景 */
  .footer-logos {
    background: #f3f0e9 !important;
    padding: 40px 10vw !important; /* 配合外层 padding 撑满全宽 */
    margin: 0 -10vw; /* 负边距打破父级 padding，让浅色背景通栏显示 */
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid rgba(23, 37, 43, 0.15) !important;
  }

  .footer-logos img {
    display: block;
    width: 100%;
    max-width: 900px;
    height: auto;
    mix-blend-mode: multiply; /* 保持原样以适应浅色底部的商标 */
  }

  /* 3. Footer 主体区域深色适配 */
  .footer-main {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 70px;
    max-width: 1100px;
    margin: 0 auto;
    padding: 65px 0 70px;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 10px;
    transform: translateX(100px);
  }

  .footer-brand-logo {
    display: block;
    width: 240px; /* 根据实际需要调整宽度 */
    height: auto;
    object-fit: contain;
    filter: brightness(0) invert(1); /* 这行代码能把黑色图片完美变成纯白色 */
  }

  .footer-brand p {
    font-family: 'Playfair Display', serif;
    margin: 20px 0 0 10px; /* 最后这个 40px 就是左边距，数值越大向右移得越多 */
    font-size: 20px;
    letter-spacing: .04em;
    color: rgb(255, 255, 255) !important;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer-links a,
  .footer-contact a {
    color: rgba(255, 255, 255, 0.85) !important;
    text-decoration: none;
    font-size: 15px;
    line-height: 1.5;
  }

  .footer-links a:hover,
  .footer-contact a:hover {
    color: white !important;
  }

  .footer-contact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .footer-column-title {
    font-size: 15px;
    color: white !important;
  }

  .footer-social {
    display: flex;
    gap: 20px;
    margin-top: 10px;
  }

  .footer-social-item img {
    width: 82px;
    height: 82px;
    object-fit: contain;
    display: block;
    border-radius: 4px;
  }

  .footer-social-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    text-align: center;
  }

  .social-platform {
    font-weight: 600;
    font-size: 13px;
    color: white !important;
    line-height: 1;
  }

  .social-service {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.6) !important;
    letter-spacing: 0.02em;
    line-height: 1;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 0 25px;
    border-top: 1px solid rgba(255, 255, 255, 0.15) !important;
    font-size: 10px;
    letter-spacing: .06em;
    color: rgba(255, 255, 255, 0.5) !important;
